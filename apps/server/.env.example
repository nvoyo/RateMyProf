# ---- Database ----
# Used by docker-compose to provision MySQL
MYSQL_ROOT_PASSWORD=rmp_root_password
MYSQL_USER=rmp
MYSQL_PASSWORD=rmp_password
MYSQL_DATABASE=rmp
MYSQL_PORT=3307

# Connection string used by the server (Drizzle)
DATABASE_URL=mysql://rmp:rmp_password@localhost:3307/rmp

# ---- Redis ----
REDIS_URL=redis://localhost:6380

# ---- Auth ----
# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# ---- Server ----
PORT=3000
# Public URL of the web app, used to build invite links inside emails
WEB_ORIGIN=http://localhost:5173

# ---- SMTP (nodemailer) ----
# Real SMTP credentials. Invites and account emails are sent through these.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Rate My Professor <no-reply@example.com>"
